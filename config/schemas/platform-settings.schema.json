{
  "$defs": {
    "ApiKeyBootstrapConfig": {
      "properties": {
        "key_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
          "title": "Key Id",
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "intended_usage": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Intended Usage"
        },
        "subject_type": {
          "default": "inference_client",
          "maxLength": 64,
          "minLength": 3,
          "title": "Subject Type",
          "type": "string"
        },
        "subject_id": {
          "maxLength": 128,
          "minLength": 3,
          "title": "Subject Id",
          "type": "string"
        },
        "scopes": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Scopes",
          "type": "array"
        },
        "secret_file": {
          "title": "Secret File",
          "type": "string"
        },
        "expires_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At"
        },
        "endpoint_mode_hint": {
          "anyOf": [
            {
              "enum": [
                "realtime",
                "batch",
                "both"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Endpoint Mode Hint"
        }
      },
      "required": [
        "key_id",
        "subject_id",
        "secret_file"
      ],
      "title": "ApiKeyBootstrapConfig",
      "type": "object"
    },
    "ApiKeyConfig": {
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "authorization_header_name": {
          "default": "Authorization",
          "title": "Authorization Header Name",
          "type": "string"
        },
        "legacy_header_name": {
          "default": "X-API-Key",
          "title": "Legacy Header Name",
          "type": "string"
        },
        "bootstrap_keys": {
          "items": {
            "$ref": "#/$defs/ApiKeyBootstrapConfig"
          },
          "title": "Bootstrap Keys",
          "type": "array"
        }
      },
      "title": "ApiKeyConfig",
      "type": "object"
    },
    "ArtifactRetentionConfig": {
      "properties": {
        "checkpoints_days": {
          "default": 30,
          "title": "Checkpoints Days",
          "type": "integer"
        },
        "training_workspace_days": {
          "default": 7,
          "title": "Training Workspace Days",
          "type": "integer"
        },
        "exports_days": {
          "default": 30,
          "title": "Exports Days",
          "type": "integer"
        },
        "batch_outputs_days": {
          "default": 14,
          "title": "Batch Outputs Days",
          "type": "integer"
        },
        "quarantine_days": {
          "default": 7,
          "title": "Quarantine Days",
          "type": "integer"
        },
        "runtime_operational_result_minutes": {
          "default": 60,
          "maximum": 1440,
          "minimum": 5,
          "title": "Runtime Operational Result Minutes",
          "type": "integer"
        },
        "runtime_result_prune_batch_size": {
          "default": 1000,
          "maximum": 100000,
          "minimum": 100,
          "title": "Runtime Result Prune Batch Size",
          "type": "integer"
        },
        "runtime_delivery_metadata_days": {
          "default": 7,
          "maximum": 365,
          "minimum": 1,
          "title": "Runtime Delivery Metadata Days",
          "type": "integer"
        },
        "runtime_capture_metadata_days": {
          "default": 30,
          "maximum": 3650,
          "minimum": 1,
          "title": "Runtime Capture Metadata Days",
          "type": "integer"
        },
        "runtime_temporal_sample_days": {
          "default": 30,
          "maximum": 3650,
          "minimum": 1,
          "title": "Runtime Temporal Sample Days",
          "type": "integer"
        }
      },
      "title": "ArtifactRetentionConfig",
      "type": "object"
    },
    "BackupConfig": {
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "metadata_retention_days": {
          "default": 30,
          "title": "Metadata Retention Days",
          "type": "integer"
        }
      },
      "title": "BackupConfig",
      "type": "object"
    },
    "CorsConfig": {
      "properties": {
        "allowed_origins": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Origins",
          "type": "array"
        },
        "allow_methods": {
          "items": {
            "type": "string"
          },
          "title": "Allow Methods",
          "type": "array"
        },
        "allow_headers": {
          "items": {
            "type": "string"
          },
          "title": "Allow Headers",
          "type": "array"
        },
        "allow_credentials": {
          "default": true,
          "title": "Allow Credentials",
          "type": "boolean"
        }
      },
      "title": "CorsConfig",
      "type": "object"
    },
    "DatabaseConfig": {
      "properties": {
        "host": {
          "default": "postgres",
          "title": "Host",
          "type": "string"
        },
        "port": {
          "default": 5432,
          "title": "Port",
          "type": "integer"
        },
        "database": {
          "default": "cv_platform",
          "title": "Database",
          "type": "string"
        },
        "user": {
          "default": "cv_platform",
          "title": "User",
          "type": "string"
        },
        "password_file": {
          "default": "/run/secrets/postgres_app_password",
          "title": "Password File",
          "type": "string"
        },
        "pool_size": {
          "default": 10,
          "title": "Pool Size",
          "type": "integer"
        }
      },
      "title": "DatabaseConfig",
      "type": "object"
    },
    "DatasetWorkflowConfig": {
      "properties": {
        "default_export_format": {
          "default": "JSON",
          "title": "Default Export Format",
          "type": "string"
        },
        "automatic_snapshot_actions": {
          "items": {
            "type": "string"
          },
          "title": "Automatic Snapshot Actions",
          "type": "array"
        },
        "minimum_annotation_count": {
          "default": 1,
          "title": "Minimum Annotation Count",
          "type": "integer"
        },
        "required_classes": {
          "items": {
            "type": "string"
          },
          "title": "Required Classes",
          "type": "array"
        },
        "default_train_ratio": {
          "default": 80,
          "title": "Default Train Ratio",
          "type": "integer"
        },
        "default_val_ratio": {
          "default": 10,
          "title": "Default Val Ratio",
          "type": "integer"
        },
        "default_test_ratio": {
          "default": 10,
          "title": "Default Test Ratio",
          "type": "integer"
        }
      },
      "title": "DatasetWorkflowConfig",
      "type": "object"
    },
    "DvcConfig": {
      "properties": {
        "repo_root": {
          "default": "/workspace/.local/dvc",
          "title": "Repo Root",
          "type": "string"
        },
        "remote_name": {
          "default": "local",
          "title": "Remote Name",
          "type": "string"
        },
        "remote_url": {
          "default": "/workspace/.local/dvc-remote",
          "title": "Remote Url",
          "type": "string"
        }
      },
      "title": "DvcConfig",
      "type": "object"
    },
    "EnvironmentName": {
      "enum": [
        "dev",
        "prod"
      ],
      "title": "EnvironmentName",
      "type": "string"
    },
    "GpuGuardrailsConfig": {
      "properties": {
        "realtime_reserved_memory_gb": {
          "default": 8,
          "title": "Realtime Reserved Memory Gb",
          "type": "integer"
        },
        "allow_training_start": {
          "default": true,
          "title": "Allow Training Start",
          "type": "boolean"
        },
        "pause_training_on_slo_pressure": {
          "default": true,
          "title": "Pause Training On Slo Pressure",
          "type": "boolean"
        }
      },
      "title": "GpuGuardrailsConfig",
      "type": "object"
    },
    "InferenceLimitsConfig": {
      "properties": {
        "realtime_timeout_ms": {
          "default": 1500,
          "title": "Realtime Timeout Ms",
          "type": "integer"
        },
        "batch_timeout_seconds": {
          "default": 300,
          "title": "Batch Timeout Seconds",
          "type": "integer"
        },
        "batch_chunk_size": {
          "default": 64,
          "title": "Batch Chunk Size",
          "type": "integer"
        },
        "realtime_max_concurrency": {
          "default": 4,
          "title": "Realtime Max Concurrency",
          "type": "integer"
        },
        "realtime_per_release_max_concurrency": {
          "default": 2,
          "title": "Realtime Per Release Max Concurrency",
          "type": "integer"
        },
        "batch_max_concurrency": {
          "default": 2,
          "title": "Batch Max Concurrency",
          "type": "integer"
        },
        "batch_per_release_max_concurrency": {
          "default": 1,
          "title": "Batch Per Release Max Concurrency",
          "type": "integer"
        },
        "realtime_requests_per_minute": {
          "default": 240,
          "title": "Realtime Requests Per Minute",
          "type": "integer"
        },
        "batch_requests_per_minute": {
          "default": 60,
          "title": "Batch Requests Per Minute",
          "type": "integer"
        },
        "metrics_window_size": {
          "default": 200,
          "title": "Metrics Window Size",
          "type": "integer"
        },
        "routing_cache_ttl_seconds": {
          "default": 5,
          "title": "Routing Cache Ttl Seconds",
          "type": "integer"
        },
        "warm_ttl_seconds": {
          "default": 120,
          "title": "Warm Ttl Seconds",
          "type": "integer"
        }
      },
      "title": "InferenceLimitsConfig",
      "type": "object"
    },
    "LabelStudioConfig": {
      "properties": {
        "base_url": {
          "default": "http://label-studio:8080",
          "title": "Base Url",
          "type": "string"
        },
        "token_file": {
          "default": "/run/secrets/labelstudio_api_token",
          "title": "Token File",
          "type": "string"
        },
        "ml_backend_adapter_url": {
          "default": "http://label-studio-ml-adapter:8089",
          "title": "Ml Backend Adapter Url",
          "type": "string"
        },
        "ml_backend_timeout_seconds": {
          "default": 60,
          "title": "Ml Backend Timeout Seconds",
          "type": "integer"
        },
        "request_timeout_seconds": {
          "default": 30,
          "title": "Request Timeout Seconds",
          "type": "integer"
        },
        "export_poll_interval_seconds": {
          "default": 3,
          "title": "Export Poll Interval Seconds",
          "type": "integer"
        },
        "export_poll_attempts": {
          "default": 40,
          "title": "Export Poll Attempts",
          "type": "integer"
        },
        "local_files_root": {
          "default": "/srv/cv-platform",
          "title": "Local Files Root",
          "type": "string"
        },
        "local_files_url_prefix": {
          "default": "/data/local-files/?d=",
          "title": "Local Files Url Prefix",
          "type": "string"
        },
        "webhook_auth": {
          "$ref": "#/$defs/LabelStudioWebhookAuthConfig"
        }
      },
      "title": "LabelStudioConfig",
      "type": "object"
    },
    "LabelStudioWebhookAuthConfig": {
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "header_name": {
          "default": "X-Label-Studio-Signature",
          "title": "Header Name",
          "type": "string"
        },
        "secret_file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "/run/secrets/labelstudio_webhook_secret",
          "title": "Secret File"
        },
        "allowed_cidrs": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Cidrs",
          "type": "array"
        }
      },
      "title": "LabelStudioWebhookAuthConfig",
      "type": "object"
    },
    "LogRetentionConfig": {
      "properties": {
        "operational_days": {
