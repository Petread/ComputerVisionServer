      "properties": {
        "host": {
          "default": "redis",
          "title": "Host",
          "type": "string"
        },
        "port": {
          "default": 6379,
          "title": "Port",
          "type": "integer"
        },
        "database": {
          "default": 0,
          "title": "Database",
          "type": "integer"
        },
