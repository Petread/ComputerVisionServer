{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ybb.local/schemas/edge-golden-image.v1.json",
  "title": "YBB Edge Golden Image Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "platform", "architecture", "base_image", "runtime", "storage", "validation"],
  "properties": {
    "schema_version": { "const": "ybb.edge.golden-image.v1" },
    "platform": { "enum": ["jetson_orin_nano", "jetson_agx_orin", "windows_11"] },
    "architecture": { "enum": ["aarch64", "x86_64"] },
    "base_image": {
      "type": "object",
      "additionalProperties": { "type": ["string", "null"] },
      "required": ["os", "image_source", "image_version"]
    },
    "runtime": {
      "type": "object",
      "additionalProperties": { "type": ["string", "null"] },
      "required": ["python", "cuda", "tensorrt"]
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system", "state_root", "minimum_bytes"],
      "properties": {
        "system": { "type": "string" },
        "state_root": { "type": "string" },
        "minimum_bytes": { "type": "integer", "minimum": 68719476736 }
      }
    },
    "validation": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  }
}
