{
  "name": "@cv-platform/admin-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "demo": "vite --mode demo --host 127.0.0.1 --strictPort",
    "build:demo": "tsc --noEmit && vite build --mode demo --outDir dist-demo",
    "preview:demo": "vite preview --mode demo --outDir dist-demo --host 127.0.0.1 --port 4173 --strictPort",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run"
  },
  "dependencies": {
    "@cv-platform/api-client": "workspace:*",
    "@cv-platform/schemas": "workspace:*",
    "@cv-platform/ui-kit": "workspace:*",
    "@tanstack/react-query": "^5.59.16",
    "@tanstack/react-router": "^1.67.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.10.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react-swc": "^3.7.1",
    "eslint": "^9.10.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.7.0",
    "vite": "^5.4.8",
    "vitest": "^2.1.1"
  }
}
